{
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "connect-redis": "^9.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "hijri-date": "^0.2.2",
    "nodemailer": "^7.0.11",
    "pg": "^8.16.3",
    "querystring": "^0.2.1",
    "redis": "^5.10.0",
    "url": "^0.11.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  },
  "scripts": {
    "dev": "nodemon --legacy-watch server.js",
    "start": "node src/server.js"
  },
  "nodemonConfig": {
    "watch": [
      "*"
    ],
    "ext": "js,json",
    "ignore": [
      "node_modules/*"
    ],
    "delay": "1000",
    "legacyWatch": true
